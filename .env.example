# Redis — optional. Falls back to in-memory dict if unset or unreachable.
REDIS_URL=redis://localhost:6379

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Log format — "json" for CloudWatch/structured logging, "text" for human-readable
LOG_FORMAT=json

# CORS — comma-separated allowed origins. Use "*" for development only.
ALLOWED_ORIGINS=*

# Rate limiting storage — "memory://" per-worker, or use REDIS_URL for cross-worker
RATE_LIMIT_STORAGE=memory://

# Rate limit for /audit endpoint (requests per minute per IP)
RATE_LIMIT_AUDIT=10/minute

# Maximum seconds a single audit may run before timing out
AUDIT_TIMEOUT_SECONDS=120

# Gunicorn workers (production — default 4)
WORKERS=4

# IBM Quantum — only needed when use_real_hardware=true in the request
IBM_QUANTUM_TOKEN=

# AWS Braket — only needed when use_real_hardware=true in the request
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
